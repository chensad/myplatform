BOARD_NAME=imx6ull_100ask_pro
BOARD_SOC=imx6ull

HOST_CCACHE_DIR=/workspace/myplatform/build/ccache
HOST_DL_DIR=/workspace/myplatform/build/downloads
HOST_LOG_DIR=/workspace/myplatform/build/logs

export BR2_DL_DIR="${HOST_DL_DIR}"
export CCACHE_DIR="${HOST_CCACHE_DIR}"

# Old vendor trees rely on Python 3 and GNU host tools being directly available.
export HOSTTOOLS_PYTHON=python3
