BOARD_NAME=myir_imx8m_plus
BOARD_SOC=imx8mp

HOST_PROJECT_DIR=/home/compile/workstation/project/codex/myplatform
HOST_CCACHE_DIR="${HOST_PROJECT_DIR}/build/ccache"
HOST_DL_DIR="${HOST_PROJECT_DIR}/build/downloads"
HOST_SSTATE_DIR="${HOST_PROJECT_DIR}/build/sstate-cache"
HOST_LOG_DIR="${HOST_PROJECT_DIR}/build/logs"

export CCACHE_DIR="${HOST_CCACHE_DIR}"
export DL_DIR="${HOST_DL_DIR}"
export SSTATE_DIR="${HOST_SSTATE_DIR}"

# Vendor Yocto trees expect classic host tool names and UTF-8 locale.
export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8
export HOSTTOOLS_PYTHON=python3
