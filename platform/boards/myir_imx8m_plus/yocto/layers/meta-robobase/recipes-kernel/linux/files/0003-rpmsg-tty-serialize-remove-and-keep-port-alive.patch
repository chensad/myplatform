-	{ .name	= "rpmsg-virtual-tty-channel-1" },
-	{ .name	= "rpmsg-virtual-tty-channel" },
+	{ .name = "rpmsg-virtual-tty-channel-1" },
+	{ .name = "rpmsg-virtual-tty-channel" },
 	{ .name = "rpmsg-openamp-demo-channel" },
